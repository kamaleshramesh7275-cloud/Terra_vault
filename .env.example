# ─── PostgreSQL / PostGIS ──────────────────────────────────────────
POSTGRES_USER=terravault
POSTGRES_PASSWORD=terravault_secret
POSTGRES_DB=terravault

# ─── Redis ────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─── MinIO ────────────────────────────────────────────────────────
MINIO_ROOT_USER=terravault
MINIO_ROOT_PASSWORD=terravault_minio_secret
MINIO_BUCKET=terravault-docs

# ─── Neo4j ────────────────────────────────────────────────────────
NEO4J_AUTH=neo4j/terravault_neo4j
NEO4J_PASSWORD=terravault_neo4j

# ─── Blockchain (Polygon Amoy Testnet) ────────────────────────────
# Get free test MATIC: https://faucet.polygon.technology
POLYGON_RPC_URL=https://rpc-amoy.polygon.technology
POLYGON_PRIVATE_KEY=your_wallet_private_key_here
CONTRACT_ADDRESS=deploy_and_paste_address_here

# ─── App ──────────────────────────────────────────────────────────
SECRET_KEY=change_this_to_a_long_random_string_in_production
ENVIRONMENT=development
LOG_LEVEL=INFO

# ─── Elasticsearch ────────────────────────────────────────────────
ELASTICSEARCH_URL=http://localhost:9200
